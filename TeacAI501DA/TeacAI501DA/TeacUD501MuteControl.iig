// ====================
//

#ifndef TeacUD501MuteControl_h
#define TeacUD501MuteControl_h

#include <AudioDriverKit/IOUserAudioBooleanControl.iig>

class TeacUD501;

class LOCALONLY TeacUD501MuteControl : public IOUserAudioBooleanControl
{
public:
    virtual bool init(IOUserAudioDriver* in_driver,
                      bool in_is_settable,
                      bool in_control_value,
                      IOUserAudioObjectPropertyElement in_control_element,
                      IOUserAudioObjectPropertyScope in_control_scope,
                      IOUserAudioClassID in_control_class_id) override;
    virtual void free() override;

    virtual kern_return_t HandleChangeControlValue(bool in_control_value) override;

    // Returns the control value to the host as a clean 0/1 UInt32. The base
    // declares this in a private class extension, which iig does not see, so
    // it cannot carry 'override'; the generated header makes it public virtual.
    virtual kern_return_t _GetPropertyData(const IOUserAudioObjectPropertyAddress* in_prop_addr,
                                           OSData* in_qualifier_data,
                                           OSData** out_data) LOCALONLY;

    virtual void SetDriverRef(TeacUD501* in_driver) LOCALONLY;
};

#endif /* TeacUD501MuteControl_h */
